# Copy to .env and fill both passwords. Neither has a default.
# Java and Compose load .env from this folder. Process environment takes precedence.
# Single-quote passwords containing spaces, # or $; no shell sourcing is needed.
DB_PASSWORD=
ADMIN_PASSWORD=
ADMIN_USERNAME=admin

# Native Java connection to compose.dev.yaml's database (Compose uses postgres:5432).
DB_URL=jdbc:postgresql://localhost:15432/home_companion
DB_USER=home_companion
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
COOKIE_SECURE=false
HOME_ORIGIN=http://localhost:8080
