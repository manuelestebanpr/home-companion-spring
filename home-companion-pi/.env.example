# configure.py fills LAN/DNS settings and generates database/Pi-hole secrets only.
# Set ADMIN_PASSWORD yourself (12+ characters, at most 72 UTF-8 bytes).
LAN_IP=192.168.1.50
UPSTREAM_DNS=192.168.1.1
TZ=America/Bogota
# Build locally or set an existing ARM64 image tag/digest.
BACKEND_IMAGE=localhost/home-companion:0.1.0
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
DB_PASSWORD=
PIHOLE_PASSWORD=
# Backend DB address, secure cookies, bind address and origin are fixed in compose.yaml.
